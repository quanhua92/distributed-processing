# Distributed Processing Configuration

# NATS JetStream (Generalized Jobs Stream)
NATS_URL=nats://127.0.0.1:4222
NATS_STREAM=JOBS
NATS_SUBJECT_REQUEST=jobs.request
NATS_SUBJECT_EVENTS=jobs.events
NATS_SUBJECT_DLQ=jobs.dlq
NATS_CONSUMER_GROUP=job-workers

# PostgreSQL 18
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=processing

# RustFS (S3-compatible)
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin123
S3_BUCKET_DATA=processing-data
S3_BUCKET_LOGS=processing-logs
S3_REGION=us-east-1

# OpenObserve & Telemetry
O2_OTLP_ENDPOINT=http://127.0.0.1:5080/api/default
O2_USER=admin@local.dev
O2_PASSWORD=Admin123!@#

# Worker Configuration
WORKER_CONCURRENCY=5
WORKER_MAX_DELIVER=3

# Audit Archival Configuration
AUDIT_BATCH_SIZE=100
AUDIT_FLUSH_INTERVAL_SECONDS=15

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

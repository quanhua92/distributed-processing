    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Job Throughput (ops/sec)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "openobserve" },
      "targets": [
        {
          "expr": "sum(rate(jobs_completed_total[1m])) or sum(rate(jobs_completed[1m]))",
          "legendFormat": "Completed ops/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(jobs_submitted_total[1m])) or sum(rate(jobs_submitted[1m]))",
          "legendFormat": "Submitted ops/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Job Processing Duration (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "openobserve" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(job_duration_ms_bucket[1m])) by (le))",
          "legendFormat": "p95 Duration",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(job_duration_ms_bucket[1m])) by (le))",
          "legendFormat": "p50 Duration",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "title": "Active Workers & Bytes Processed",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "openobserve" },
      "targets": [
        {
          "expr": "sum(active_workers) or sum(active_workers_gauge) or vector(0)",
          "legendFormat": "Active In-Flight Workers",
          "refId": "A"
        },
        {
          "expr": "sum(rate(bytes_processed_total[1m])) or sum(rate(bytes_processed[1m]))",
          "legendFormat": "Bytes/sec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        },
        "overrides": []
      }
    }

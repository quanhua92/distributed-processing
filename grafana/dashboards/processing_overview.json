      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "openobserve" },
      "targets": [
        {
          "expr": "sum(audit_batches_flushed_total) or sum(audit_batches_flushed) or vector(0)",
          "legendFormat": "Flushed Batches",
          "refId": "A"
        }
      ],
      "fieldConfig": {
